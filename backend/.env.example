# Base de donnees PostgreSQL
DATABASE_URL=postgresql://uee_user:uee_password@localhost:5432/uee_emig

# Securite (a changer en production ! genere avec: openssl rand -hex 32)
SECRET_KEY=change-moi-avec-une-vraie-cle-secrete-en-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180

# Compte administrateur cree automatiquement au premier lancement
ADMIN_EMAIL=admin@uee-emig.ne
ADMIN_PASSWORD=change-moi-mot-de-passe-admin

# CORS - adresse du frontend
FRONTEND_ORIGIN=http://localhost:5173

# Cloudinary (stockage permanent des photos, gratuit) - laisser vide en local
# si tu veux garder les photos sur le disque de ta machine
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
